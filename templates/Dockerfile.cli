# PHP CLI built from the official tarball, same flags for vulnerable and fixed.
# Only PHP_VERSION / PHP_SHA256 differ between the two images, so a difference
# in behaviour is a difference in PHP, not in the build.
FROM debian:bookworm-slim

ARG PHP_VERSION=8.5.11
ARG PHP_SHA256=

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libxml2-dev pkg-config ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN curl -fsSL -o php.tar.xz "https://www.php.net/distributions/php-${PHP_VERSION}.tar.xz" \
    && echo "${PHP_SHA256}  php.tar.xz" | sha256sum -c - \
    && tar xf php.tar.xz \
    && mv "php-${PHP_VERSION}" php

WORKDIR /src/php
RUN ./configure --disable-all --enable-cli --enable-session --without-pear \
    && make -j"$(nproc)" \
    && make install

RUN php -v && php -m | grep -i '^session$'

WORKDIR /srv
CMD ["php", "-v"]
